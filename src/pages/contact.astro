---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import { site } from "../../site.config";
import { topCategories } from "../lib/content";
---
<Base title="Contact" description={`Contact the ${site.product} support team.`}>
  <div class="wrap">
    <Crumbs items={[["Home", "/"], ["Contact"]]} />
    <header class="page-head">
      <h1 class="display">Contact</h1>
      <p class="descriptor">If the help articles have not answered your question, send the team a message.</p>
    </header>
    <section class="section">
      <p><a class="button gold" href={`mailto:${site.contactEmail}`}>Email {site.contactEmail}</a></p>
      <p style="max-width: var(--measure)">Including the page you were on, what you expected to happen, and the device and browser you were using helps us answer faster.</p>
      <form class="form" method="post" action={`mailto:${site.contactEmail}`} enctype="text/plain">
        <label>Your name <input id="name" name="name" required /></label>
        <label>Your email <input id="email" name="email" type="email" required /></label>
        <label>What is this about?
          <select id="topic" name="topic">
            {topCategories.map((c) => <option>{c.title}</option>)}
            <option>Something else</option>
          </select>
        </label>
        <label>Message <textarea id="message" name="message" rows="6" required></textarea></label>
        <button class="button" type="submit">Send</button>
      </form>
    </section>
  </div>
</Base>
