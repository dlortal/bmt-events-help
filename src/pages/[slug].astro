---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import { allPages, fmt } from "../lib/content";
export async function getStaticPaths() {
  return (await allPages()).map((p) => ({ params: { slug: p.id }, props: { page: p } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
// Imported summaries are the first paragraph; do not show them twice.
const norm = (s: string) => s.replace(/[*_`\[\]"'‘’“”]/g, "").replace(/\s+/g, " ").trim().toLowerCase();
const summary = page.data.summary;
const showSummary = summary && !norm(page.body ?? "").slice(0, 400).startsWith(norm(summary).replace(/…$/, "").slice(0, 60));
---
<Base title={page.data.title} description={page.data.summary}>
  <div class="wrap">
    <Crumbs items={[["Home", "/"], [page.data.title]]} />
    <div class="article-layout">
      <article class="article" data-pagefind-body>
        <h1 class="title">{page.data.title}</h1>
        {showSummary && <p class="descriptor">{summary}</p>}
        <div class="prose"><Content /></div>
        {page.data.updated && <p class="updated">Updated {fmt(page.data.updated)}</p>}
      </article>
    </div>
  </div>
</Base>
