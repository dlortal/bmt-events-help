---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import { site } from "../../../site.config";
import { allArticles, articlesIn, categoryBySlug, fmt } from "../../lib/content";
export async function getStaticPaths() {
  return (await allArticles()).map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const category = categoryBySlug(article.data.category);
const siblings = await articlesIn(article.data.category);
const tag = [category?.title, article.data.subcategory].filter(Boolean).join(" · ");
---
<Base title={article.data.title} description={article.data.summary}>
  <div class="wrap">
    <Crumbs items={[["Home", "/"], ["Help articles", "/help-articles/"], [category?.title ?? article.data.category, `/help-articles-category/${article.data.category}/`], [article.data.title]]} />
    <div class="article-layout">
      <article class="article" data-pagefind-body>
        <p class="eyebrow">{tag}</p>
        <h1 class="display">{article.data.title}</h1>
        {article.data.summary && <p class="descriptor">{article.data.summary}</p>}
        <div class="prose"><Content /></div>
        {article.data.updated && <p class="updated">Updated {fmt(article.data.updated)}</p>}
      </article>
      <aside class="aside" data-pagefind-ignore>
        <h2>In {category?.title}</h2>
        <ul>
          {siblings.map((s) => <li><a href={`/help-articles/${s.id}/`} aria-current={s.id === article.id ? "page" : undefined}>{s.data.title}</a></li>)}
        </ul>
        <div class="helpbox">
          <p><strong>Still stuck?</strong></p>
          <p>Email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> and one of the team will get back to you.</p>
        </div>
      </aside>
    </div>
  </div>
</Base>
