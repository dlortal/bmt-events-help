---
import { site } from "../../site.config";
import Logo from "./Logo.astro";
const path = Astro.url.pathname;
const current = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap">
    <Logo />
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="nav" id="site-nav" aria-label="Primary">
      <ul>
        {site.nav.map((n) => <li><a href={n.href} aria-current={current(n.href) ? "page" : undefined}>{n.label}</a></li>)}
        <li><a class="search-link" href="/search/" aria-current={current("/search/") ? "page" : undefined}>Search</a></li>
      </ul>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.getElementById("site-nav");
  btn?.addEventListener("click", () => {
    const open = nav!.classList.toggle("open");
    btn.setAttribute("aria-expanded", String(open));
  });
</script>
