---
import { site } from "../../site.config";
interface Props { items: [string, string?][] }
// The first crumb is the help site's own front page; the header lockup goes to the BMT website instead.
const items = Astro.props.items.map(([label, href]) => (label === "Home" && href === "/" ? [`${site.name} home`, href] : [label, href]) as [string, string?]);
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map(([label, href]) => href ? <li><a href={href}>{label}</a></li> : <li aria-current="page">{label}</li>)}
  </ol>
</nav>
