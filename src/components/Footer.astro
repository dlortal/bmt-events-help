---
// Footer structure follows the original help sites: menu row, description columns, copyright and company details.
import { site } from "../../site.config";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <nav class="footer-menu" aria-label="Footer">
    <div class="wrap">
      <ul>
        {site.nav.map((n) => <li><a href={n.href} target={n.external ? "_blank" : undefined} rel={n.external ? "noopener" : undefined}>{n.label}</a></li>)}
      </ul>
    </div>
  </nav>
  <div class="footer-body">
    <div class="wrap">
      {site.footerColumns.map((c) => (
        <section class="footer-col">
          <h2>{c.title}</h2>
          <p>{c.text}</p>
        </section>
      ))}
    </div>
  </div>
  <div class="footer-bottom">
    <div class="wrap">
      <p>&copy; {year} <a href={site.websiteUrl} target="_blank" rel="noopener">{site.copyright}</a> &middot; {site.smallprint}</p>
      <ul>
        {site.legalLinks.map((n) => <li><a href={n.href} target="_blank" rel="noopener">{n.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
