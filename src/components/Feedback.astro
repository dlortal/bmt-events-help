---
// "Was this article helpful?" under each article. Yes/No is recorded by the Worker (worker/feedback.ts).
// After "No", visitors can send a comment to the support team when Turnstile is set up
// (PUBLIC_TURNSTILE_SITE_KEY at build time); until then the support box below is the next step.
// Switch the whole widget off with feedback: false in site.config.ts. Setup: docs/FEEDBACK.md.
import { site } from "../../site.config";
interface Props { slug: string; title: string }
const { slug, title } = Astro.props;
const sitekey: string = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const enabled = (site as { feedback?: boolean }).feedback !== false;
---
{enabled && (
  <section class="feedback" data-feedback data-article={slug} data-title={title} data-sitekey={sitekey || undefined}
    aria-labelledby="feedback-q" data-pagefind-ignore>
    <h2 id="feedback-q" class="feedback-q">Was this article helpful?</h2>
    <div class="feedback-choices">
      <button type="button" class="feedback-choice" data-vote="yes" aria-pressed="false">Yes</button>
      <button type="button" class="feedback-choice" data-vote="no" aria-pressed="false">No</button>
    </div>
    <form class="feedback-form" hidden novalidate>
      <label for="feedback-comment">What were you looking for? Your comment goes to the support team.</label>
      <textarea id="feedback-comment" name="comment" rows="4" maxlength="1000" required></textarea>
      <div class="feedback-hp" aria-hidden="true"><label>Leave empty <input name="_hp" tabindex="-1" autocomplete="off" /></label></div>
      <div class="feedback-turnstile"></div>
      <button type="submit" class="button gold">Send comment</button>
    </form>
    <p class="feedback-status" role="status" aria-live="polite"></p>
  </section>
)}
